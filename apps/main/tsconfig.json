{
  // Type-check config (`check-ts`, editors, Vitest): src, test and vitest.config.ts.
  // Output settings (`outDir`, `rootDir`) live in tsconfig.build.json: with an
  // `outDir` here, TypeScript 6's default `rootDir` (this directory) rejects
  // vitest.config.ts's import of the root vitest.shared.ts.
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2021", "esnext"],
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    // Mongoose @Schema classes declare fields that Mongoose fills, and AAS domain
    // classes assign backing fields through setters (276 TS2564 errors with it on).
    "strictPropertyInitialization": false,
    "inlineSources": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
