{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Europe/Berlin",
  schedule: ["before 6am"],
  labels: ["dependencies"],
  prConcurrentLimit: 10,
  prHourlyLimit: 0,

  // Load-bearing. "bump" makes Renovate update pnpm-lock.yaml with
  // `pnpm install --lockfile-only`. Do NOT switch to "update-lockfile": that runs
  // `pnpm update --no-save … --recursive`, which with injectWorkspacePackages
  // writes injected copies of the workspace packages resolved against newer
  // @nestjs/* and zod versions than the importers. Two ConfigService / ZodType
  // instances then break the build (this is exactly why the Dependabot PRs were red).
  rangeStrategy: "bump",

  // Must stay >= pnpm's minimumReleaseAge (1440 min, see pnpm-workspace.yaml),
  // otherwise Renovate proposes versions pnpm's supply-chain gate refuses and the
  // lockfile update fails.
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",

  // Commits by the changeset bot (.github/workflows/renovate-changeset.yml).
  // Without this, Renovate treats a PR that carries one as edited and stops
  // rebasing it. Renovate's own rebases drop the bot commit, and the workflow
  // adds it again. Matches the GitHub App `open-dpp-changeset-bot` (see
  // RELEASING.md); the numeric prefix is the App's bot user ID.
  gitIgnoredAuthors: ["/^\\d+\\+open-dpp-changeset-bot\\[bot\\]@users\\.noreply\\.github\\.com$/"],

  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
    // Vulnerability PRs would otherwise default to a lockfile-only update
    // (`pnpm update --no-save`, the split-graph problem above). These PRs
    // target dependencies declared in a package.json, so bumping the range is
    // always possible and keeps them on the `pnpm install` path.
    rangeStrategy: "bump",
  },

  // Periodic full re-resolve. Regenerating the whole lockfile moves every range
  // together, so it stays consistent (unlike a partial `pnpm update`).
  lockFileMaintenance: { enabled: true },

  packageRules: [
    {
      // The better-auth plugins peer-depend on better-auth and @better-auth/core per
      // minor, and a missing @better-auth/core peer resolves to the newest release
      // (splitting the core graph). Bump the whole family in one PR.
      groupName: "better-auth",
      matchPackageNames: ["better-auth", "@better-auth/**"],
    },
    {
      // Node 26 LTS is the baseline (Dockerfile, CI `NODE_VERSION`, .node-version,
      // `engines`). The runtime and its typings move to the next major together,
      // by hand, as one deliberate change, not as a scheduled Renovate PR.
      matchPackageNames: ["node", "@types/node"],
      allowedVersions: "<27",
    },
    {
      // TypeScript 7 is the native compiler without the JS compiler API that the
      // Nest CLI (every builder), `nest generate`, fork-ts-checker,
      // @rollup/plugin-typescript and vue-tsc call. Moving to 7 is its own effort,
      // done by hand; Renovate keeps the 6.0 patches coming.
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      // A NestJS major moves core and every satellite (swagger, mongoose, config,
      // serve-static, axios, ...) together: each satellite peers on the new core only,
      // so split PRs can never be green on their own. One PR per Nest major.
      groupName: "nestjs majors",
      matchPackageNames: ["@nestjs/**"],
      matchUpdateTypes: ["major"],
    },
  ],
}
